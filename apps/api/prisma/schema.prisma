generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScrapeType {
  VIDEO
  PROFILE
}

enum ScrapeStatus {
  SUCCESS
  FAILED
}

enum VideoJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model ScrapeHistory {
  id             String       @id @default(cuid())
  telegramUserId String?
  url            String
  type           ScrapeType
  status         ScrapeStatus @default(SUCCESS)
  views          BigInt?
  likes          BigInt?
  comments       BigInt?
  shares         BigInt?
  followers      BigInt?
  totalLikes     BigInt?
  totalVideos    Int?
  errorMessage   String?
  scrapedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())
  videoJobStatus VideoJobStatus?
  videoJobError  String?
  videos         ProfileVideoScrape[]
  @@index([scrapedAt])
  @@index([type])
}

model ProfileVideoScrape {
  id              String        @id @default(cuid())
  scrapeHistoryId String
  scrapeHistory   ScrapeHistory @relation(fields: [scrapeHistoryId], references: [id], onDelete: Cascade)
  videoId         String
  videoUrl        String
  description     String?
  views           BigInt?
  likes           BigInt?
  comments        BigInt?
  shares          BigInt?
  coverUrl        String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  @@index([scrapeHistoryId])
  @@index([videoId])
}
